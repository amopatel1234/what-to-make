# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "fileutils"

default_platform(:ios)
platform :ios do
  PROJECT_NAME = "whattomake.xcodeproj"
  APP_IDENTIFIER = "amishpatel.whattomake"
  APP_TARGET = "whattomake"
  PROVISIONING_PROFILE_NAME = "ForkPlan App Store"
  # Keep in sync with the snapshot directory and the verified runner inventory.
  TEST_DEVICE_NAME = "iPhone 17"
  TEST_OS_VERSION = "27.0"
  PINNED_TEST_DESTINATION = "platform=iOS Simulator,name=#{TEST_DEVICE_NAME},OS=#{TEST_OS_VERSION}"
  TOOLCHAIN_CHECK = File.expand_path("../scripts/check-apple-toolchain.py", __dir__)
  PROJECT_ROOT = File.expand_path("..", __dir__)

  desc "Validate an unsigned Release build for the iOS device SDK without archiving or uploading"
  lane :validateRelease do
    sh("python3", TOOLCHAIN_CHECK)
    output_directory = File.join(PROJECT_ROOT, "fastlane/test_output")
    FileUtils.mkdir_p(output_directory)
    result_bundle = File.join(output_directory, "release-#{Time.now.utc.strftime('%Y%m%d%H%M%S')}.xcresult")
    sh(
      "xcodebuild",
      "-workspace", File.join(PROJECT_ROOT, ENV.fetch("WORKSPACE_FILENAME", "whattomake.xcworkspace")),
      "-scheme", ENV.fetch("SCHEME", "whattomake"),
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "-sdk", "iphoneos",
      "-derivedDataPath", File.join(PROJECT_ROOT, "build/ReleaseDerivedData"),
      "-resultBundlePath", result_bundle,
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    )
  end

  desc "Compile the app and test targets for the pinned simulator without signing or running tests"
  lane :buildForTesting do
    sh("python3", TOOLCHAIN_CHECK, "--simulator-name", TEST_DEVICE_NAME, "--simulator-os", TEST_OS_VERSION)
    run_tests(
      workspace: ENV.fetch("WORKSPACE_FILENAME", "whattomake.xcworkspace"),
      scheme: ENV.fetch("SCHEME", "whattomake"),
      testplan: ENV.fetch("TEST_PLAN", "UnitTestsPlan"),
      destination: PINNED_TEST_DESTINATION,
      build_for_testing: true,
      derived_data_path: "build/DerivedData",
      output_directory: "fastlane/test_output",
      buildlog_path: "fastlane/test_output/build_logs",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      result_bundle: true,
    )
  end

  desc "Run unit and snapshot tests (UnitTestsPlan) on iPhone 17 / iOS 27.0"
  lane :runUnitTests do
    required_vars = ['WORKSPACE_FILENAME', 'SCHEME', 'TEST_PLAN']
    required_vars.each do |var|
      UI.user_error!("Missing required environment variable: #{var}") if ENV[var].to_s.strip.empty?
    end

    sh("python3", TOOLCHAIN_CHECK, "--simulator-name", TEST_DEVICE_NAME, "--simulator-os", TEST_OS_VERSION)

    # UnitTestsPlan includes MenuGeneratorTests, RecipeSnapshotTests, MenuSnapshotTests, etc.
    run_tests(
      workspace: ENV["WORKSPACE_FILENAME"],
      scheme: ENV["SCHEME"],
      testplan: ENV["TEST_PLAN"],
      destination: PINNED_TEST_DESTINATION,
      buildlog_path: "fastlane/test_output/build_logs",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      ensure_devices_found: true,
      result_bundle: true,
    )
  end

  desc "Deploy to App Store Connect"
  lane :deploy do
    release_version = ENV["RELEASE_VERSION"]
    if release_version.nil? || release_version.empty?
      UI.important("Nothing to deploy: no GitHub release was created for this merge")
      next
    end

    sh("python3", TOOLCHAIN_CHECK)

    marketing_version = get_version_number(
      xcodeproj: PROJECT_NAME,
      target: APP_TARGET
    )

    UI.message("GitHub release version: #{release_version}")
    UI.message("App Store marketing version (from Xcode): #{marketing_version}")

    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_VALUE"]
    )

    password = SecureRandom.hex
    keychain_name = "signing_temp"

    create_keychain(
      name: keychain_name,
      password: password,
      unlock: true
    )

    begin
      import_certificate(
        certificate_path: "distribution.p12",
        certificate_password: ENV["CERTIFICATE_PASSWORD"],
        keychain_password: password,
        keychain_name: keychain_name
      )

      begin
        latest_build = latest_testflight_build_number(
          app_identifier: APP_IDENTIFIER,
          version: marketing_version
        )
        build_number = latest_build + 1
      rescue => e
        UI.important("No TestFlight builds found for #{marketing_version}: #{e.message}")
        build_number = 1
      end

      increment_build_number(
        build_number: build_number,
        xcodeproj: PROJECT_NAME
      )

      UI.message("Build number for #{marketing_version}: #{build_number}")

      get_provisioning_profile(
        readonly: true,
        app_identifier: APP_IDENTIFIER,
        provisioning_name: PROVISIONING_PROFILE_NAME
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        code_sign_identity: "Apple Distribution",
        profile_name: PROVISIONING_PROFILE_NAME,
        targets: "whattomake"
      )

      ipa_path = gym(
        workspace: "whattomake.xcworkspace",
        scheme: "whattomake",
        export_method: "app-store",
        destination: "generic/platform=iOS",
        sdk: "iphoneos"
      )

      UI.success("Built IPA at: #{ipa_path}")

      testing_notes_path = File.join(__dir__, "testing_notes.txt")
      UI.user_error!("Missing #{testing_notes_path} — add What to Test notes before deploy") unless File.exist?(testing_notes_path)
      testing_notes = File.read(testing_notes_path).strip
      UI.user_error!("fastlane/testing_notes.txt is empty — add a short What to Test sentence before deploy") if testing_notes.empty?
      UI.message("TestFlight What to Test notes:\n#{testing_notes}")

      upload_to_testflight(
        skip_submission: true,
        app_platform: "ios",
        changelog: testing_notes
      )
    ensure
      delete_keychain(name: keychain_name)
    end
  end
end
